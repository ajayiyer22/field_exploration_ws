<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>search_bringup</name>
  <version>0.1.0</version>
  <description>
    Launch and configuration for multi-robot exploration: rmf_demos worlds, Clearpath
    robots, ground-truth localization, exploration map, Nav2 and the exploration stack.
  </description>
  <maintainer email="ajayiyer2397@tamu.edu">ajayiyer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>rmf_demos_maps</build_depend>
  <build_depend>python3-yaml</build_depend>

  <exec_depend>rmf_demos_maps</exec_depend>
  <exec_depend>rmf_demos_gz</exec_depend>
  <exec_depend>rmf_building_sim_gz_plugins</exec_depend>
  <exec_depend>clearpath_gz</exec_depend>
  <exec_depend>clearpath_generator_gz</exec_depend>
  <exec_depend>clearpath_config</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_smac_planner</exec_depend>
  <exec_depend>nav2_mppi_controller</exec_depend>
  <exec_depend>nav2_rotation_shim_controller</exec_depend>
  <exec_depend>nav2_common</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>search_sim</exec_depend>
  <exec_depend>search_perception</exec_depend>
  <exec_depend>exploration_map</exec_depend>
  <exec_depend>search_exploration</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
