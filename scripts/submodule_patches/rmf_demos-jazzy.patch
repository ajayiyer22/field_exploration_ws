+    root = ET.fromstring(contents)
+    world = root.find('world')
+    if world is None:
+        raise RuntimeError(f'World element not found in {world_path}')
+    # Parse elements rather than matching the generator's whitespace. Jazzy
+    # generates gz::sim plugins; retain support for existing Fortress worlds.
+    harmonic = any(
+        plugin.get('name', '').startswith('gz::sim::')
+        for plugin in world.findall('plugin')
     )
+    additions = SENSOR_SYSTEMS
+    if harmonic:
+        additions = additions.replace('libignition-gazebo-', 'libgz-sim-')
+        additions = additions.replace('ignition::gazebo::', 'gz::sim::')
+    for element in ET.fromstring('<additions>' + additions + '</additions>'):
+        if element.tag == 'plugin':
+            if any(p.get('name') == element.get('name') for p in world.findall('plugin')):
+                continue
+        elif world.find(element.tag) is not None:
+            continue
+        world.append(element)
+    ET.indent(root)
+    world_path.write_text(ET.tostring(root, encoding='unicode'))
 
 
