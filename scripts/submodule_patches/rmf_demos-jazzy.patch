 from pathlib import Path
 import re
 import sys
+import xml.etree.ElementTree as ET
 
 
 SENSOR_SYSTEMS = """    <plugin filename="libignition-gazebo-sensors-system.so" name="ignition::gazebo::systems::Sensors">
@@ -55,22 +56,29 @@ def main() -> None:
         r'<physics name="[^"]+"', '<physics name="2ms"', contents, count=1,
     )
 
-    if 'name="ignition::gazebo::systems::Sensors"' in contents:
-        world_path.write_text(contents)
-        return
-
-    if SCENE_BROADCASTER not in contents:
-        raise RuntimeError(
-            f"SceneBroadcaster insertion point not found in {world_path}"
-        )
-
-    world_path.write_text(
-        contents.replace(
-            SCENE_BROADCASTER,
-            SCENE_BROADCASTER + SENSOR_SYSTEMS,
